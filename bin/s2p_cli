#!/usr/bin/env python

import argparse
from pathlib import Path
from glob import glob
import sys
from datetime import datetime
import yaml
import numpy as np
from random import randint
from suite2p import run_s2p
import shutil
import os
from suite2p.detection import chan2detect
import random

sys.path.append('/home/kevinsit/code/process-recording')

from helpers.si_tiff import SItiffCore
from helpers.artifacts import detect_artifact_bounds, _resolve_fallback
import tifffile
import s2p_ops

# Minimum holography-artifact crop, in px PER SIDE, floored onto whatever
# detection returns (and onto the fallback). Symmetric, so it is set by whichever
# side is worse, and it is itself capped at 0.4*Lx in detect_artifact_bounds.
#
# Was 100, set from KKS082-1/260804: bands visible only to x~90, but ROIs to x~147
# still carried a step locked to the photostim window, which faked a positive
# network response in cells far from every target. 100 removed 231 of that
# session's 243 contaminated ROIs, and 150 was judged not worth a further ~24% of
# the population.
#
# Raised to 150 on the contrast-shift set (KKS082-1 260811/12/13, KKS083-1 260814),
# where 100 is measurably not enough. Measuring the 900 nm dose effect per 48px
# band of the scan axis, in all four recordings:
#
#     x 96-144   -0.056 to -0.077 dF   contaminated
#     x 144-384  -0.015 to +0.006 dF   clean
#     x 384-432  -0.017 to -0.022 dF   contaminated
#
# so contamination runs to x~144 on the left and from x~384 on the right (128px in).
# The mechanism is not the visible band but neuropil over-subtraction beside it: in
# x 96-144 the soma ROI gains -0.6 ADU while its neuropil annulus gains +10.7, so
# F - 0.7*Fneu manufactures a -8.1 ADU step. flag_photostim_artifact then keeps
# exactly those cells, because it only drops POSITIVE steps.
#
# 150 covers the left side with a little margin and matches the band validated
# downstream (x 150-380). Being symmetric it crops to 362 on the right, ~18px more
# than needed -- the price of a single floor. It costs ~35% of targets, which is why
# a per-frame background subtraction (see helpers/artifacts.py) is the better fix:
# it keeps those cells instead of cropping them.
#
# The 260804 and contrast-shift numbers genuinely disagree, so this is a floor set
# by the worst session seen, not a rig constant. Detection may still widen it.
#
# REQUIRES the lab suite2p fork (neurognome/suite2p), which is what implements
# ops['remove_artifacts'] -- read_tiff takes an x_crop_rng and tiff_to_binary passes
# it (commits a466eb2, c949dcd). Upstream MouseLand suite2p has no such option and
# silently ignores the key, so a clone pointed at upstream produces UNCROPPED data
# with remove_artifacts sitting inertly in the saved ops.npy. That is exactly what
# happened to the four contrast-shift recordings. If a session comes out with
# ops['Lx'] == the full frame width while ops['remove_artifacts'] is set, check
# `git remote -v` in the suite2p clone before anything else.
ARTIFACT_MIN_CROP = 150

# fallback crop applied when auto-detection finds no band (e.g. the sampled tiff
# has no photostim frames). An int gives a symmetric px/side crop; a
# (x_start, x_end) tuple gives explicit bounds; None disables it (no crop). The
# min-crop floor above applies either way, so this only matters if it is wider.
ARTIFACT_FALLBACK = ARTIFACT_MIN_CROP

def printline():
    print('-----------------------------------------------------')

def read_tiffs(input):
    with tifffile.TiffFile(input) as tif:
        for tag in tif.pages[0].tags:
            print(tag.name)
            print(tag.value)

TIFF_BASE = '/mnt/data/raw'
RESULT_BASE = '/mnt/data/processed'

##--- handle args ---##
parser = argparse.ArgumentParser(description='Run Suite2p!')
parser.add_argument('mouse', type=str)
parser.add_argument('date', type=str)
parser.add_argument('dest', type=str,
                    help="name of folder to save into. will be create if it doesn't exist")
parser.add_argument('-a', '--autorun',
                    action='store_true', dest='autorun')
parser.add_argument('--resultbase', 
                    help='result base folder location',
                    default=RESULT_BASE, dest='result_path')
parser.add_argument('--tiffbase', 
                    help='tiff base folder location',
                    default=TIFF_BASE, dest='tiff_loc')
parser.add_argument('-o', '--ops_to_use',
                    help='which ops to run',
                     default='default_ops', dest='ops', type=str)

args = parser.parse_args()
ops_to_use = args.ops
autorun = args.autorun

##--- make paths ---##
result_base = Path(args.result_path, args.dest)
tiff_base = args.tiff_loc

art = """
    __QQ
   (_)_">
  _)      

Process new experiment with suite2p!

"""
print(art)
print(f'\nYour save path will be: {result_base}\n')
print(f'\nYou will be using ops: {ops_to_use}')

expt_path = Path(args.tiff_loc, args.mouse, args.date)
root_data = [f for f in expt_path.iterdir()]
pth = sorted([f for f in root_data if f.is_dir()])

# do prompt
if autorun:
    group_idxs = [[e for e in range(len(pth))]]
else:
    while True:
        print(f'Looking in: {expt_path}\n')
        print('Type the number of the epochs to keep with spaces in between. (use 0-based indexing)')
        print(f'(eg. -> 1 2 5 6)\n')
        print(f'Or.. type a for all\n')

        for i,p in enumerate(pth):
            print(f'{i}: {p.stem}')

        epoch_input = input('-> ')
        if epoch_input == 'a':
            print('\nYou chose to sequentially do all epochs?')
            printline()
            # group_idxs = list(range(len(pth)))
            group_idxs = [[e] for e in range(len(pth))]
        else:
            epoch_list = epoch_input.split(' ')
            epoch_idxs = [int(e) for e in epoch_list]
            group_idxs = [epoch_idxs]

            print('\nYou chose these epochs?')
            printline()

            chosen_epochs = [pth[i] for i in epoch_idxs]
            for e in chosen_epochs:
                print(e)

        ans = input('(y/n): ')
        if ans == 'y':
            break
        elif ans == 'n':
            print('\nOK, try again... (press ctrl-C to exit)')
            continue
        else:
            print('not an acceptable input! (press ctrl-C to exit)')

mismatched_groups = []
for g in group_idxs:
    epoch_folders = [pth[i] for i in g]
    epoch_names = [Path(epoch).stem for epoch in epoch_folders]
    mouse = args.mouse
    date = args.date
    data_path = [str(Path(tiff_base, mouse, date, lbl).as_posix()) for lbl in epoch_names]
    save_path = str(Path(result_base, mouse, date, '_'.join(epoch_names)).as_posix())

    # append notes
    # notes = input('\nNotes: ')

    # save everything into a record file
    db_out = {
        'mouse': mouse,
        'date': date,
        'epochs': epoch_names,
        'result_folder': args.dest,
        'data_path': data_path,
        'save_path': save_path,
        # 'notes': notes
    }

    dt = datetime.now().strftime("%Y%m%d_%H%M%S")
    db_save_path = '__'.join([date, mouse, 'suite2p', dt])+'.yml'

    save_locs = [
        Path('/mnt/data/processed/db', db_save_path),
    ]
    for sv in save_locs:
        with open(sv, 'w') as f:
            yaml.dump(db_out, f, default_flow_style=False)

    # printline()
    # # look for a reference channel for red.. if reference channel exists with no red, skip it, its not useful
    # refimg_loc = list(expt_path.glob('*refimg*'))
    # if refimg_loc:
    #     tmp_tiff = SItiffCore(str(refimg_loc[0]))
    # else:
    #     print('Searching for a dual channel recording...')
    #     all_tiffs = [SItiffCore(glob(d + '/*.tif')[0]) for d in data_path] # get the first tiff from each epoch 
    #     tmp_tiff = all_tiffs[[a.nchannels for a in all_tiffs].index(2)]

    #tmp_tiff needs to both exist and have 2 channels, then that trips a flag for later, fix this
    # if tmp_tiff.nchannels > 1:
    #     temp_id = ''.join(str(randint(0, 9)) for _ in range(10))
    #     temp_save_path = Path(result_base, mouse, date, temp_id).as_posix()
    #     db = {
    #         'save_path0': str(temp_save_path),
    #         'data_path': [str(Path(tmp_tiff.path).parent.as_posix())],
    #         'tiff_list': [tmp_tiff.path],
    #         'nchannels': tmp_tiff.nchannels,
    #         'nplanes': tmp_tiff.nplanes,
    #         'fs': tmp_tiff.fr
    #     }
    #     ops = getattr(s2p_ops, 'red')
    #     print('Processing refimg')
    #     red_ops = run_s2p(ops=ops, db=db)
    #     is_dual_channel = True
    # else: 
    #     print('Unable to get any red channel data.')
    #     is_dual_channel = False

    # Every epoch must have been acquired like the first one: nchannels / nplanes below come from ONE tif and
    # suite2p applies them to the whole run, so an epoch saved differently gets its frames assigned to the wrong
    # channel / plane. Seen 2024-2026: a screen saved with channels [1 2] before 1-channel experiments (planes
    # 0/2 then hold one slice, 1/3 another; slices 1/3 land in "red"), a single-plane epoch in a volume run.
    acquired = {}
    for d in data_path:
        t = SItiffCore(sorted(glob(d + '/*.tif'))[0], backend='tifffile')
        acquired[Path(d).name] = (t.nchannels, t.nplanes)
    if len(set(acquired.values())) > 1:
        print('\nERROR: these epochs were acquired with different channel / plane counts:')
        for e, (c, p) in acquired.items():
            print(f'    {e}: {c} channel(s), {p} plane(s)')
        print('suite2p would process them all one way and assign frames to the wrong channel / plane.\n'
              'Process them as separate runs, or make them match first (a screen saved with channels [1 2]:\n'
              '~/code/nwb-pipeline/tools/strip_ch2_epoch.py <raw date dir> <epoch>). Skipping this group.\n')
        mismatched_groups.append(epoch_names)
        continue

    # setup s2p db
    # copy so per-group mutations (artifact bounds, fast_disk) don't leak across epochs
    ops = dict(getattr(s2p_ops, ops_to_use))
    tmp_tiff = SItiffCore(glob(data_path[0] + '/*.tif')[0], backend='tifffile') # get the first tiff from each epoch

    db = {
        'save_path0': save_path,
        'data_path': data_path,
        'nchannels': tmp_tiff.nchannels,#max([t.nchannels for t in all_tiffs]), #temporary..., tmp_tiff.nchannels,
        'nplanes': tmp_tiff.nplanes,
        'fs': tmp_tiff.fr
    }

    # adaptive holography-artifact trimming: replace the 'auto' sentinel with
    # data-driven (x_start, x_end) column bounds detected from this recording.
    # Bands are transient (photostim frames only), so detection differences
    # artifact vs clean frames per plane -- see helpers/artifacts.py.
    if ops.get('remove_artifacts') == 'auto':
        Lx = tmp_tiff.data.shape[-1]
        try:
            func_ch = ops.get('functional_chan', 1) - 1  # 0-based; green/functional
            bounds, info = detect_artifact_bounds(tmp_tiff.data,
                                                  nplanes=tmp_tiff.nplanes,
                                                  nchannels=tmp_tiff.nchannels,
                                                  func_ch=func_ch,
                                                  fallback=ARTIFACT_FALLBACK,
                                                  min_crop=ARTIFACT_MIN_CROP,
                                                  return_info=True)
            ops['remove_artifacts'] = bounds
            how = ('detected' if info['detected'] else
                   'fallback' if info['fallback_used'] else 'no band')
            if info['widened_to_min_crop']:
                how += f', widened to the {ARTIFACT_MIN_CROP}px/side minimum'
            print(f'Artifact bounds [{how}]: keep x[{bounds[0]}:{bounds[1]}] '
                  f'(trim L={bounds[0]}, R={Lx - bounds[1]}) of {Lx}px width.')
        except Exception as e:
            fallback = _resolve_fallback(ARTIFACT_FALLBACK, Lx)
            f = min(ARTIFACT_MIN_CROP, Lx // 2)          # floor it here too
            fallback = (max(fallback[0], f), min(fallback[1], Lx - f))
            ops['remove_artifacts'] = fallback
            print(f'WARNING: auto artifact detection failed ({e!r}); '
                  f'falling back to {fallback}.')

    # generate a randomized folder for fast

    sfx = random.randint(1, 999999999) # random
    ops['fast_disk'] = ops['fast_disk'] + '/' + str(sfx)

    print(ops['fast_disk'])
    os.mkdir(ops['fast_disk'])

    printline()
    print('Starting suite2p...')
    run_s2p(ops=ops, db=db)

    # persist the ScanImage acquisition metadata alongside the suite2p output so
    # downstream analysis (which only sees the suite2p folder, not the raw tiffs)
    # can derive the real optotune z-plane depths instead of hard-coding them.
    # zs == commanded optotune positions (SI.hStackManager.zs); nplanes follows.
    si_meta = {
        'zs': tmp_tiff.zs,
        'nplanes': tmp_tiff.nplanes,
        'nchannels': tmp_tiff.nchannels,
        'fr': tmp_tiff.fr,
    }
    si_meta_path = Path(save_path, 'suite2p', 'si_metadata.npy')
    np.save(si_meta_path, si_meta)
    print(f'Saved SI metadata sidecar: {si_meta_path} (zs={si_meta["zs"]})')

    # printline()
    # print('Labelling red cells...')
    # # load stat
    # stat_files = Path(save_path).rglob('stat.npy')
    # for s in stat_files:
    #     print(s.as_posix())
    #     stat = np.load(str(s.as_posix()), allow_pickle=True)
    #     breakpoint()
    #     _, redcell = chan2detect.detect(ops_out, stat)
    #     np.save(Path(s).parent.joinpath('redcell.npy'), redcell)
    # #cleanup
    # shutil.rmtree(temp_save_path)

    shutil.rmtree(ops['fast_disk']) # cleanup after yoself

    # NWB: convert this run in the background (~/code/nwb-pipeline/bin/nwb-hook -> /mnt/data/nwb).
    # Detached and non-fatal: processing never waits on it or fails because of it; a failed conversion
    # is retried by the nightly sweep. NWB_HOOK=0 disables it.
    nwb_hook = Path.home() / 'code' / 'nwb-pipeline' / 'bin' / 'nwb-hook'
    if os.environ.get('NWB_HOOK', '1') != '0' and nwb_hook.exists():
        try:
            import subprocess
            subprocess.Popen([str(nwb_hook), str(Path(save_path, 'suite2p'))], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f'NWB conversion started in the background ({nwb_hook})')
        except Exception as e:
            print(f'NWB hook not started: {e}')
print('Finished!')
if mismatched_groups:
    sys.exit(f'Not processed (epochs acquired differently): {mismatched_groups}')
